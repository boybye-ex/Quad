# Supabase Configuration
# Get the anon key from: https://supabase.com/dashboard/project/tawjmefiddlpvualfunc/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://tawjmefiddlpvualfunc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack Configuration (South Africa Payments)
# Get keys from: https://dashboard.paystack.com/#/settings/developers
# Use test keys (pk_test_, sk_test_) for development
# WARNING: Never commit real secret keys!
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here

# Feature Flags
# Set to 'true' to enable payments UI (requires valid Paystack public key)
EXPO_PUBLIC_PAYMENTS_ENABLED=false

# =============================================================================
# SERVER-SIDE SECRETS (Supabase Edge Functions)
# =============================================================================
# These secrets are NOT set in .env - they are configured via Supabase CLI:
#
# PAYSTACK_SECRET_KEY - Required for payment verification
#   Set with: supabase secrets set PAYSTACK_SECRET_KEY=sk_test_your-secret-key
#   Get from: https://dashboard.paystack.com/#/settings/developers
#
# After setting secrets, deploy the Edge Functions:
#   supabase functions deploy paystack-initialize
#   supabase functions deploy paystack-verify
#
# For webhooks, set the URL in Paystack Dashboard:
#   https://tawjmefiddlpvualfunc.supabase.co/functions/v1/paystack-verify
